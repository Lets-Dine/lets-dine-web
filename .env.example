# The backend's base URL, including the version prefix. Unset (or empty) and the
# app runs entirely in the browser against src/api/client.ts.
VITE_API_URL=http://localhost:3100/api/v1

# The QR entry screen at "/" stands in for the code printed on a table. There is
# no public endpoint that hands out table tokens, so point it at a real one:
#
#   cd ../lets-dine-backend && npm run db:seed
#   docker exec lets-dine-db psql -U postgres -d lets_dine \
#     -tAc "select name, qr_token from public.dining_tables order by sort_order"
#
# Or sign in as staff and read GET /api/v1/restaurant/tables. Put the pair in
# .env.local, which is gitignored, since the token changes on every reseed.
VITE_DEMO_SLUG=newa-kitchen
VITE_DEMO_TABLE_TOKEN=
