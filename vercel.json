{
  "rewrites": [
    {
      "source": "/r/:slug",
      "destination": "/api/restaurant-share?slug=:slug"
    },
    {
      "source": "/r/:slug/delivery",
      "destination": "/api/restaurant-share?slug=:slug&kind=delivery"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
